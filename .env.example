# Server
PORT=4000

# Database (matches docker-compose.yml defaults)
# 5433 on the host to avoid clashing with a locally installed Postgres on 5432
DB_HOST=localhost
DB_PORT=5433
DB_USER=hotello
DB_PASSWORD=hotello
DB_NAME=hotello

# JWT — generate strong random values for real deployments
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_REFRESH_EXPIRES=7d

# Seed (npm run seed) — first Super Admin account
SEED_ADMIN_NAME=Super Admin
SEED_ADMIN_EMAIL=admin@hotello.app
SEED_ADMIN_PASSWORD=ChangeMe123

# Tenancy URLs — computed from the hotel slug, never stored
TENANT_BASE_DOMAIN=gxp.example
GUEST_APP_BASE_URL=https://guest.gxp.example

# Hotel owner setup links (one-time, single-use)
SETUP_TOKEN_TTL_HOURS=72

# File storage — 'local' (default) or 's3'; DB stores keys, never URLs
STORAGE_DRIVER=local
UPLOADS_PATH=./uploads
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
