# Server
PORT=4000

# Database (matches docker-compose.yml defaults)
# 5433 on the host to avoid clashing with a locally installed Postgres on 5432
DB_HOST=localhost
DB_PORT=5433
DB_USER=hotello
DB_PASSWORD=hotello
DB_NAME=hotello

# JWT — generate strong random values for real deployments
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_REFRESH_EXPIRES=7d

# Tenant (Hotel) Dashboard JWT — MUST differ from the platform secrets above so
# an admin token is never valid on tenant routes and vice versa (Epic 08)
TENANT_JWT_ACCESS_SECRET=dev-tenant-access-secret-change-me
TENANT_JWT_ACCESS_EXPIRES=15m
TENANT_JWT_REFRESH_SECRET=dev-tenant-refresh-secret-change-me
TENANT_JWT_REFRESH_EXPIRES=7d

# Tenant password-reset links (single-use, short-lived) — Epic 08 Story 8.4
RESET_TOKEN_TTL_HOURS=2

# Tenant subscription-state cache (ms) — how long access state is cached per
# request cycle; low enough that trial/expiry/suspension land within seconds
TENANT_ACCESS_CACHE_TTL_MS=10000

# Seed (npm run seed) — first Super Admin account
SEED_ADMIN_NAME=Super Admin
SEED_ADMIN_EMAIL=admin@hotello.app
SEED_ADMIN_PASSWORD=ChangeMe123

# Tenancy URLs — computed from the hotel slug, never stored
TENANT_BASE_DOMAIN=gxp.example
GUEST_APP_BASE_URL=https://guest.gxp.example

# Hotel owner setup links (one-time, single-use)
SETUP_TOKEN_TTL_HOURS=72

# Notifications / email (Epic 06) — 'log' (default) writes rendered emails to
# the app log + outbox only; 'smtp' sends via the SMTP_* settings below
MAIL_DRIVER=log
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
MAIL_FROM_ADDRESS=no-reply@gxp.example
MAIL_FROM_NAME=GXP Platform
NOTIFICATION_MAX_ATTEMPTS=3
NOTIFICATION_RETRY_BASE_MS=60000

# File storage — 'local' (default) or 's3'; DB stores keys, never URLs
STORAGE_DRIVER=local
UPLOADS_PATH=./uploads
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
