# Server
PORT=4000

# Database (matches docker-compose.yml defaults)
# 5433 on the host to avoid clashing with a locally installed Postgres on 5432
DB_HOST=localhost
DB_PORT=5433
DB_USER=hotello
DB_PASSWORD=hotello
DB_NAME=hotello

# JWT — generate strong random values for real deployments
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_REFRESH_EXPIRES=7d

# Tenant (Hotel) Dashboard JWT — MUST differ from the platform secrets above so
# an admin token is never valid on tenant routes and vice versa (Epic 08)
TENANT_JWT_ACCESS_SECRET=dev-tenant-access-secret-change-me
TENANT_JWT_ACCESS_EXPIRES=15m
TENANT_JWT_REFRESH_SECRET=dev-tenant-refresh-secret-change-me
TENANT_JWT_REFRESH_EXPIRES=7d

# Tenant password-reset links (single-use, short-lived) — Epic 08 Story 8.4
RESET_TOKEN_TTL_HOURS=2

# Tenant subscription-state cache (ms) — how long access state is cached per
# request cycle; low enough that trial/expiry/suspension land within seconds
TENANT_ACCESS_CACHE_TTL_MS=10000

# Seed (npm run seed) — first Super Admin account
SEED_ADMIN_NAME=Super Admin
SEED_ADMIN_EMAIL=admin@hotello.app
SEED_ADMIN_PASSWORD=ChangeMe123

# Tenancy URLs — computed from the hotel slug, never stored
TENANT_BASE_DOMAIN=gxp.example
GUEST_APP_BASE_URL=https://guest.gxp.example

# Hotel owner setup links (one-time, single-use)
SETUP_TOKEN_TTL_HOURS=72

# Notifications / email (Epic 06) — 'log' (default) writes rendered emails to
# the app log + outbox only; 'smtp' sends via the SMTP_* settings below
MAIL_DRIVER=log
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
MAIL_FROM_ADDRESS=no-reply@gxp.example
MAIL_FROM_NAME=GXP Platform
NOTIFICATION_MAX_ATTEMPTS=3
NOTIFICATION_RETRY_BASE_MS=60000

# Stays & guest sessions (Epic 13)
# Stay codes are stored as deterministic HMAC-SHA256 hashes with this secret —
# rotating it invalidates every active stay code (guests re-enter via the desk)
STAY_CODE_HMAC_SECRET=dev-stay-code-hmac-secret-change-me
# Guest session JWT — a third universe: MUST differ from both admin and tenant
# secrets so tokens never cross. Expiry is derived per stay (checkout + buffer);
# GUEST_JWT_MAX_TTL_DAYS caps it for absurdly long stays
GUEST_JWT_SECRET=dev-guest-secret-change-me
GUEST_JWT_MAX_TTL_DAYS=30
# Brute-force layers for POST /guest/{slug}/session (13.5 AC3): per IP+room
# attempts within a window, then escalating lockouts (base doubles per repeat,
# capped); plus a per-hotel-per-IP window that blocks room scanning
GUEST_LOGIN_ROOM_LIMIT=5
GUEST_LOGIN_ROOM_WINDOW_MS=900000
GUEST_LOGIN_ROOM_LOCKOUT_BASE_MS=900000
GUEST_LOGIN_ROOM_LOCKOUT_MAX_MS=86400000
GUEST_LOGIN_HOTEL_LIMIT=30
GUEST_LOGIN_HOTEL_WINDOW_MS=3600000
# Guest App public profile cache (Epic 14) — per-slug, ms
GUEST_PROFILE_CACHE_TTL_MS=60000

# File storage — 'local' (default) or 's3'; DB stores keys, never URLs
STORAGE_DRIVER=local
UPLOADS_PATH=./uploads
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
